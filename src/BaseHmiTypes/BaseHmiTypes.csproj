<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>BaseHmiTypes</PackageId>
    <Title>BaseHmiTypes</Title>
    <Authors>JFK Solutions</Authors>
    <Description>A neutral HMI model assembly for Siemens visualization project readers and converters.</Description>
    <PackageProjectUrl>https://github.com/jfk-solutions/BaseHmiTypes</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jfk-solutions/BaseHmiTypes.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>HMI;Siemens;WinCC;TIA Portal;ProTool</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <AssemblyVersion>2026.8.5.1</AssemblyVersion>
            <Version>2026.8.5.1</Version>
        <FileVersion>2026.8.5.1</FileVersion>
     <ProductVersion>2026.8.5.1</ProductVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
