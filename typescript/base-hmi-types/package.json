{
  "name": "@jfk-solutions/base-hmi-types",
  "version": "2026.10.6-1",
  "description": "Neutral TypeScript mirror of the BaseHmiTypes C# HMI model.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalogs/unified/*": "./dist/catalogs/unified/*"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.txt",
    "THIRD-PARTY-LICENSES"
  ],
  "scripts": {
    "build": "node scripts/prepare-unified-catalog.mjs && tsc -p tsconfig.json && node scripts/copy-unified-catalogs.mjs",
    "prepack": "npm run build",
    "test": "node --test tests/**/*.test.js"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "^5.9.3"
  }
}
